    "@tanstack/react-query": "5.87.0",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "yjs": "13.6.27"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "6.0.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "vite": "8.3.0",
    "vitest": "3.2.4"
  },
  "packageManager": "npm@10.9.2"
